              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test(\"Role is user\", () => pm.expect(u.role).to.eql(\"user\"));",
                  "pm.test(\"No password in response\", () => pm.expect(u).to.not.have.property(\"hashed_password\"));",
