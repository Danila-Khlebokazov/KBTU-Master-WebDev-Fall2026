{
  "info": {
    "_postman_id": "90e91d2b-75f5-4b79-97ef-c6dca0eac7f1",
    "name": "Spendwise - Expense Tracker API",
    "description": "Demo requests for the Spendwise API, split into two folders:\n\n1. **User**: a regular user logs in, creates/updates/deletes an expense.\n2. **Admin**: the admin manages categories and users.\n\n**How to use:** start the stack (`docker compose up`), then open each folder and send requests **top to bottom**, or run the whole collection with the Collection Runner. Tokens and IDs are saved to collection variables automatically, you never copy them by hand.\n\n**Variables you may change** (collection → *Variables*): `baseUrl`, `userEmail`, `userPassword`, `adminEmail`, `adminPassword`. The rest are filled automatically.\n\nSee the *Postman* section of README.md for details.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "description": "Use http://localhost:8000/api to call the backend directly"
    },
    {
      "key": "userEmail",
      "value": "aruzhan@example.com",
      "description": "Any demo user or your own account"
    },
    {
      "key": "userPassword",
      "value": "demo12345"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "description": "Must match ADMIN_EMAIL"
    },
    {
      "key": "adminPassword",
      "value": "admin12345",
      "description": "Must match ADMIN_PASSWORD"
    },
    {
      "key": "userToken",
      "value": "",
      "description": "auto: Login as user"
    },
    {
      "key": "adminToken",
      "value": "",
      "description": "auto: Login as admin"
    },
    {
      "key": "userId",
      "value": "",
      "description": "auto: Who am I"
    },
    {
      "key": "categoryId",
      "value": "",
      "description": "auto: List categories"
    },
    {
      "key": "expenseId",
      "value": "",
      "description": "auto: Create expense"
    },
    {
      "key": "newCategoryId",
      "value": "",
      "description": "auto: Create category"
    }
  ],
  "item": [
    {
      "name": "1. User",
      "description": "Flow of a regular user (demo account `{{userEmail}}`). Run requests **top to bottom**: `Login` saves `userToken`, `List categories` saves `categoryId`, `Create expense` saves `expenseId`; later requests use these variables.\n\nAll requests in this folder inherit `Bearer {{userToken}}` from the folder auth.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login as user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Log in with `userEmail` / `userPassword` from the collection variables. The token is saved to `userToken` automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"userToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Profile of the token owner. Saves `userId` (used by the Admin folder)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.test(\"Role is user\", () => pm.expect(me.role).to.eql(\"user\"));",
                  "pm.collectionVariables.set(\"userId\", me.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Shared categories (read-only for users). The first one is saved to `categoryId` and used when creating an expense."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json()[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Create an expense owned by the current user. Saves `expenseId`.\n\n**Editable:** `title` (1-200 chars), `amount` (> 0, KZT), `spent_on` (`YYYY-MM-DD`), `note` (optional), `category_id` (any ID from *List categories* or `null`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coffee with friends\",\n  \"amount\": 2500,\n  \"spent_on\": \"2026-10-15\",\n  \"note\": \"Created from Postman\",\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"expenseId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my expenses (filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses?q=coffee&date_from=2026-10-01&date_to=2026-10-31&limit=10&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "coffee",
                  "description": "Search in title (case-insensitive)"
                },
                {
                  "key": "date_from",
                  "value": "2026-10-01",
                  "description": "From date, YYYY-MM-DD"
                },
                {
                  "key": "date_to",
                  "value": "2026-10-31",
                  "description": "To date, YYYY-MM-DD"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Page size, 1-100"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Items to skip"
                }
              ]
            },
            "description": "Only the current user's expenses, newest first. Every query param is optional: untick or change them in the **Params** tab."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "description": "Full replacement of the expense created above: send **all** fields. Same editable fields as *Create expense*.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coffee and dessert\",\n  \"amount\": 3800,\n  \"spent_on\": \"2026-10-15\",\n  \"note\": \"Updated from Postman\",\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Amount updated\", () => pm.expect(pm.response.json().amount).to.eql(3800));"
                ]
              }
            }
          ]
        },
        {
          "name": "Expense summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/summary?date_from=2026-10-01&date_to=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "summary"
              ],
              "query": [
                {
                  "key": "date_from",
                  "value": "2026-10-01",
                  "description": "From date"
                },
                {
                  "key": "date_to",
                  "value": "2026-10-31",
                  "description": "To date"
                }
              ]
            },
            "description": "Totals per category for the period (remove the params for all time)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category -> 403 (admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Role check: a regular user cannot create categories, the API answers `403`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Not allowed\",\n  \"color\": \"#000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete expense",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "description": "Delete the expense created above, so the demo data stays clean. Returns `204`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoke `userToken` on the server. Any further request with it returns `401`; run *Login as user* again to get a new one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Admin",
      "description": "Flow of the administrator (`{{adminEmail}}`). Run **after** the User folder (it needs `userId`). Run requests top to bottom: `Login` saves `adminToken`, `Create category` saves `newCategoryId`.\n\nAll requests in this folder inherit `Bearer {{adminToken}}` from the folder auth.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Log in with `adminEmail` / `adminPassword`. They must match `ADMIN_EMAIL` / `ADMIN_PASSWORD` from `.env`. The token is saved to `adminToken`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "All registered accounts (admin only)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Expenses of one user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses?owner_id={{userId}}&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ],
              "query": [
                {
                  "key": "owner_id",
                  "value": "{{userId}}",
                  "description": "User ID (admin only)"
                },
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Page size, 1-100"
                }
              ]
            },
            "description": "Admins see everyone's expenses. `owner_id` narrows the list to one user (`userId` was saved by *Who am I* in the User folder). Remove it to see all users."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "description": "Create a shared category. Saves `newCategoryId`.\n\n**Editable:** `name` (unique, case-insensitive; `409` if it exists), `color` (`#RRGGBB`).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee\",\n  \"color\": \"#8b5cf6\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"newCategoryId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/{{newCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{newCategoryId}}"
              ]
            },
            "description": "Rename / recolor the category created above. Send both `name` and `color`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coffee & Snacks\",\n  \"color\": \"#f59e0b\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories/{{newCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories",
                "{{newCategoryId}}"
              ]
            },
            "description": "Delete the category created above. Expenses in it would become uncategorized. Returns `204`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Partial update: send only the fields to change.\n\n**Editable:** `full_name`, `role` (`user` / `admin`), `is_active` (`false` blocks login). The example keeps the demo user as is.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aruzhan Nurlanovna\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revoke `adminToken`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
